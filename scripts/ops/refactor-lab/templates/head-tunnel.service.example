[Unit]
Description=Private SSH tunnel to Octopus refactor lab on 4090
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -F /dev/null -p 22409 -i /etc/octopus-refactor-lab/tunnel_ed25519 -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -NT -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -L 127.0.0.1:21830:127.0.0.1:21830 -L 127.0.0.1:21910:127.0.0.1:21910 -R 127.0.0.1:21820:127.0.0.1:21820 lht@127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
