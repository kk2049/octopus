{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.example.org/schemas/octopus-architecture-waivers-v1.json",
  "title": "Octopus Architecture Constraint Waivers",
  "type": "object",
  "required": ["version", "waivers"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["constraintId", "witness", "reason", "owner", "created_at", "expires_at"],
        "properties": {
          "constraintId": { "$ref": "#/$defs/id" },
          "witness": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "created_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  }
}
