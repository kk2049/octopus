{
  "name": "@claude-bot/capability-kernel",
  "version": "0.1.0",
  "description": "A scenario-neutral capability kernel with attenuating grants, complete mediation, durable approvals, and SQLite persistence.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.example.com/lvht/octopus.git",
    "directory": "packages/capability-kernel"
  },
  "homepage": "https://gitlab.example.com/lvht/octopus/-/tree/v4/packages/capability-kernel#readme",
  "bugs": "https://gitlab.example.com/lvht/octopus/-/issues",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist",
    "linkDirectory": false
  },
  "scripts": {
    "build": "node ../../tools/build-cache/bin/octo-build.mjs -- 'tsup src/index.ts --format esm --dts --clean && node scripts/prepare-package.mjs'",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "@types/better-sqlite3": "^7.6.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0"
  }
}
