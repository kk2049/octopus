{
  "name": "@claude-bot/dashboard-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/paths.ts",
  "types": "src/paths.ts",
  "exports": {
    ".": {
      "types": "./src/paths.ts",
      "default": "./src/paths.ts"
    },
    "./contract": {
      "types": "./src/contract.ts",
      "default": "./src/contract.ts"
    },
    "./live-contract": {
      "types": "./src/live-contract.ts",
      "default": "./src/live-contract.ts"
    },
    "./projection-delta": {
      "types": "./src/projection-delta.ts",
      "default": "./src/projection-delta.ts"
    },
    "./theme-registry": {
      "types": "./src/styles/theme-registry.ts",
      "default": "./src/styles/theme-registry.ts"
    }
  },
  "scripts": {
    "build": "node ../../tools/build-cache/bin/octo-build.mjs -- 'vite build && node scripts/report-bundle-size.mjs'",
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@claude-bot/agent-sessions-contract": "workspace:*",
    "@claude-bot/chat-ui-commons": "workspace:*",
    "@claude-bot/flight-recorder": "workspace:*",
    "@claude-bot/web-trust": "workspace:*",
    "antd": "^6.6.0",
    "d3-hierarchy": "^3.1.2",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-virtual": "^3.13.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.64.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "react-router": "^7.9.4",
    "remark-gfm": "^4.0.1",
    "@claude-bot/agent-view-react": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.1.9"
  }
}
